# ==============================================================================
# VectorTrade Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your actual credentials.
# NEVER commit the active .env file to version control.

# MongoDB Atlas Database URI (e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority)
# If left empty or "mock", the engine operates in local in-memory/mock mode for offline testing.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vectortrade

# MegaBull Paper Trading API Credentials
# Valid api-key obtained from https://trade.megabull.in profile settings (1-month validity)
MEGABULL_API_KEY=your_megabull_api_key_here
MEGABULL_USER_ID=your_megabull_user_id_here
MEGABULL_BASE_URL=https://api.megabull.in

# Operational Settings
LOG_LEVEL=INFO
APP_NAME=VectorTrade
TIMEZONE=Asia/Kolkata
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=3

# Inter-Process Communication Security (Offline <-> Online)
# Pre-shared secret token for cryptographic handshake and endpoint authentication
INTERNAL_AUTH_TOKEN=vt_sec_789f2a4bc81d45e69b03e2c4d8e1a7
ONLINE_BASE_URL=http://localhost:8000
