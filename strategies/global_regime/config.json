{
  "strategy_id": "global_regime",
  "name": "Global Regime Strategy",
  "display_name": "7-Day Global Market Regime Forecaster",
  "enabled": true,
  "type": "global_regime",
  "version": "1.0.0",
  "description": "Full market forward 7-day maximum gain and maximum drawdown asymmetric forecaster. Evaluates all market rows without setup filtering to model market-wide regime behavior.",
  "triggers": {
    "forward_horizon_days": 7,
    "min_gain_pct": 4.0,
    "max_drop_pct": 4.0,
    "gain_drop_ratio": 2.0
  },
  "training": {
    "filter_strategy_data": false,
    "filter_condition": "all_data",
    "target_gain": "max_gain_7d",
    "target_drop": "max_loss_7d",
    "train_test_split_ratio": 0.8,
    "chronological_split": true,
    "leakage_columns": [
      "base_signal",
      "signal_strength",
      "entry_price",
      "stop_loss",
      "risk",
      "target_1_2",
      "target_hit",
      "sl_hit",
      "timeout",
      "outcome",
      "days_to_outcome",
      "return_7d_after_signal",
      "max_gain_7d",
      "max_loss_7d",
      "mfe",
      "mae",
      "Trade_Triggered",
      "max_r_achieved",
      "date",
      "symbol",
      "sector",
      "Stock Symbol",
      "Sector",
      "Trading_Day_Of_Week"
    ],
    "param_grid": {
      "n_estimators": [
        100,
        200
      ],
      "max_depth": [
        3,
        4,
        5
      ],
      "learning_rate": [
        0.01,
        0.05,
        0.1
      ],
      "subsample": [
        0.8,
        1.0
      ]
    },
    "correlation_prune_threshold": 0.9
  },
  "inference": {
    "min_gain_pct": 4.0,
    "max_drop_pct": 4.0,
    "gain_drop_ratio": 2.0
  },
  "artifacts": {
    "gain_model": "models/5_year_global_gain_model.pkl",
    "drop_model": "models/5_year_global_drop_model.pkl",
    "scaler": "models/5_year_global_scaler.pkl",
    "imputer": "models/5_year_global_imputer.pkl",
    "features": "global_features.txt",
    "base_gain_model": "models/global_gain_base.pkl",
    "base_drop_model": "models/global_drop_base.pkl",
    "base_scaler": "models/global_base_scaler.pkl",
    "base_imputer": "models/global_base_imputer.pkl",
    "base_features": "global_base_features.txt"
  }
}